{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schoolpark:economy:external-quote:v1",
  "title": "Future external adapter quote (not an executable instruction)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "chainId",
    "inputToken",
    "outputToken",
    "inputAmountBaseUnits",
    "outputAmountBaseUnits",
    "observedAtMs",
    "expiresAtMs",
    "provider",
    "executable"
  ],
  "properties": {
    "version": { "const": 1 },
    "mode": { "enum": ["sandbox", "live-readonly"] },
    "chainId": { "type": "integer", "minimum": 1 },
    "inputToken": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "outputToken": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "inputAmountBaseUnits": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,77}$"
    },
    "outputAmountBaseUnits": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,77}$"
    },
    "observedAtMs": { "type": "integer", "minimum": 1 },
    "expiresAtMs": { "type": "integer", "minimum": 1 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 60 },
    "executable": { "const": false }
  }
}
