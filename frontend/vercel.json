{
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/emu-post?id=:id"
    },
    {
      "source": "/api/billing/features",
      "destination": "https://emu-realtime.onrender.com/api/billing/features"
    },
    {
      "source": "/api/knowledge-lab/:path*",
      "destination": "https://emu-realtime.onrender.com/api/knowledge-lab/:path*"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://emusch-2a111.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/schoolpark/entry-status",
      "destination": "https://emu-realtime.onrender.com/api/schoolpark/entry-status"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api/|p/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|gif|svg|ico|woff2|woff|ttf|mp3|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
