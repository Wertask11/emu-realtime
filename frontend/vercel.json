{
  "rewrites": [
    {
      "source": "/.well-known/openid-credential-issuer/api/passport-v2/sd",
      "destination": "https://emu-realtime.onrender.com/.well-known/openid-credential-issuer/api/passport-v2/sd"
    },
    {
      "source": "/.well-known/jwt-vc-issuer/api/passport-v2/issuer",
      "destination": "https://emu-realtime.onrender.com/.well-known/jwt-vc-issuer/api/passport-v2/issuer"
    },
    {
      "source": "/.well-known/openid-credential-issuer/api/passport-v2",
      "destination": "https://emu-realtime.onrender.com/.well-known/openid-credential-issuer/api/passport-v2"
    },
    {
      "source": "/.well-known/oauth-authorization-server/api/passport-v2",
      "destination": "https://emu-realtime.onrender.com/.well-known/oauth-authorization-server/api/passport-v2"
    },
    {
      "source": "/api/passport-v2/:path*",
      "destination": "https://emu-realtime.onrender.com/api/passport-v2/:path*"
    },
    {
      "source": "/p/:id",
      "destination": "/api/emu-post?id=:id"
    },
    {
      "source": "/api/billing/features",
      "destination": "https://emu-realtime.onrender.com/api/billing/features"
    },
    {
      "source": "/api/knowledge-lab/:path*",
      "destination": "https://emu-realtime.onrender.com/api/knowledge-lab/:path*"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://emusch-2a111.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/schoolpark/entry-status",
      "destination": "https://emu-realtime.onrender.com/api/schoolpark/entry-status"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api/|p/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|gif|svg|ico|woff2|woff|ttf|mp3|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/passport-v2/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/api/passport-v2/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/.well-known/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
