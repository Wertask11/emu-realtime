rules_version = '2';

// EMUER の計算根拠（posts / ches_accounts）と非公開下書きを、
// クライアントから任意に改ざんできないように保護する。
// Firebase Admin SDK を使うサーバー処理は、従来どおりルールをバイパスする。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountPath() {
      return /databases/$(database)/documents/ches_accounts/$(request.auth.uid);
    }

    function hasAccount() {
      return signedIn() && exists(accountPath());
    }

    function wallet() {
      return get(accountPath()).data.walletAddress;
    }

    function isMyWallet(value) {
      return hasAccount()
        && value is string
        && wallet() is string
        && value.lower() == wallet().lower();
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /emuer_offchain/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ───────── 有料会員（月額10,000円） ─────────
    // 金額・会員状態・返金・本人確認は、すべてサーバー(Admin SDK)だけが書き込む。
    // クライアントから書けると、課金せずに会員になったり返金状態を偽装できてしまう。

    // 自分の契約状態だけ読める。書き込みは Stripe Webhook 経由のサーバーのみ。
    match /subscriptions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Stripe イベントの冪等性記録。クライアントからは一切触らせない。
    match /billing_events/{document=**} {
      allow read, write: if false;
    }

    // 返金申請。申請も承認もサーバー経由のみ（金額をサーバーが決めるため）。
    match /refund_requests/{document=**} {
      allow read, write: if false;
    }

    // 本人確認。書類の所在や判定結果をクライアントから読めないようにする。
    match /kyc_submissions/{document=**} {
      allow read, write: if false;
    }

    // 対話記録と対話可能枠。保証の判定根拠なので、本人でも直接は書き換えられない。
    match /dialogue_sessions/{document=**} {
      allow read, write: if false;
    }
    match /dialogue_slots/{document=**} {
      allow read, write: if false;
    }

    // 監査ログ。改ざん・削除を防ぐためクライアントからは完全に遮断する。
    match /admin_audit_logs/{document=**} {
      allow read, write: if false;
    }

    // フィードバック。投稿も閲覧もサーバー経由のみ（他人の意見を読めないようにする）。
    match /emu_feedback/{document=**} {
      allow read, write: if false;
    }

    // 立てられた議論。誰でも一覧を読めて、参加できる。
    // 作成・更新は自分名義のときだけ（同じ議題は同じIDに集約されるため update も許す）。
    match /discussion_rooms/{id} {
      allow read: if true;
      allow create, update: if isMyWallet(request.resource.data.author)
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0
        && request.resource.data.topic.size() <= 120;
      allow delete: if false;
    }

    // 議論から生まれた「みんなの結論」。誰でも読めるが、書けるのは
    // 自分名義で新規に残すときだけ。他人の結論の書き換え・削除はできない。
    match /discussion_conclusions/{id} {
      allow read: if true;
      allow create: if isMyWallet(request.resource.data.author)
        && request.resource.data.conclusion is string
        && request.resource.data.conclusion.size() > 0
        && request.resource.data.conclusion.size() <= 600;
      allow update, delete: if false;
    }

    match /emuer_offchain_ledger/{document=**} {
      allow read, write: if false;
    }

    match /ches_accounts/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.walletAddress is string
        && !request.resource.data.keys().hasAny(['lastLoginBonusDate']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && changedOnly(['lastLogin', 'displayName', 'email', 'photoURL']);
      allow delete: if false;
    }

    match /ches_wallets/{address} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && address.lower() == wallet().lower();
      allow read, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isMyWallet(request.resource.data.address)
        && request.resource.data.get('goodCount', 0) == 0
        && request.resource.data.get('changeCount', 0) == 0
        && request.resource.data.get('goodUsers', []).size() == 0
        && request.resource.data.get('changeUsers', []).size() == 0;

      // 投稿者本人による本文編集。反応数・反応者一覧・投稿者は変更不可。
      allow update: if isMyWallet(resource.data.address) && changedOnly([
        'title', 'body', 'tags', 'userType', 'userId', 'updatedAt', 'imageUrl',
        'displayName'
      ])
      || (isMyWallet(resource.data.address)
        && changedOnly(['acceptedChangeCount', 'lastChangedAt'])
        && request.resource.data.get('acceptedChangeCount', 0) == resource.data.get('acceptedChangeCount', 0) + 1)
      // Good は、認証ユーザー自身のウォレットを1件追加し、件数を1増やす場合だけ許可。
      || (hasAccount()
        && !isMyWallet(resource.data.address)
        && changedOnly(['goodCount', 'goodUsers'])
        && request.resource.data.get('goodCount', 0) == resource.data.get('goodCount', 0) + 1
        && request.resource.data.get('goodUsers', []).size() == resource.data.get('goodUsers', []).size() + 1
        && request.resource.data.get('goodUsers', []).hasAll(resource.data.get('goodUsers', []))
        && wallet().lower() in request.resource.data.get('goodUsers', [])
        && !(wallet().lower() in resource.data.get('goodUsers', [])))
      // Change も同じく、1ユーザーにつき1件だけ許可。
      || (hasAccount()
        && !isMyWallet(resource.data.address)
        && changedOnly(['changeCount', 'changeUsers'])
        && request.resource.data.get('changeCount', 0) == resource.data.get('changeCount', 0) + 1
        && request.resource.data.get('changeUsers', []).size() == resource.data.get('changeUsers', []).size() + 1
        && request.resource.data.get('changeUsers', []).hasAll(resource.data.get('changeUsers', []))
        && wallet().lower() in request.resource.data.get('changeUsers', [])
        && !(wallet().lower() in resource.data.get('changeUsers', [])));

      allow delete: if isMyWallet(resource.data.address);
    }

    match /knowledge_drafts/{draftId} {
      allow create: if isMyWallet(request.resource.data.owner);
      allow read, update, delete: if isMyWallet(resource.data.owner);
    }

    match /post_good_impacts/{impactId} {
      allow read: if signedIn();
      allow create: if isMyWallet(request.resource.data.fromAddress)
        && request.resource.data.postId is string;
      allow update, delete: if false;
    }

    match /post_changes/{changeId} {
      allow read: if signedIn();
      allow create: if isMyWallet(request.resource.data.fromAddress)
        && request.resource.data.postId is string
        && request.resource.data.get('accepted', false) == false;
      allow update: if signedIn()
        && get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.address.lower() == wallet().lower()
        && resource.data.status == 'pending'
        && changedOnly(['status', 'acceptedAt', 'acceptedBy'])
        && request.resource.data.status == 'accepted';
      allow delete: if false;
    }

    match /knowledge_requests/{requestId} {
      allow read: if signedIn();
      allow create: if isMyWallet(request.resource.data.author)
        && request.resource.data.status == 'open'
        && request.resource.data.answerCount == 0
        && request.resource.data.settlementStatus == 'uncommitted';
      allow update: if signedIn() && (
        (isMyWallet(resource.data.author) && changedOnly([
          'status', 'acceptedAnswerId', 'acceptedAnswerAuthor', 'awardedAt', 'settlementStatus'
        ])
          && request.resource.data.status == 'awarded'
          && request.resource.data.settlementStatus == 'pending_distribution'
          && getAfter(/databases/$(database)/documents/knowledge_answers/$(request.resource.data.acceptedAnswerId)).data.requestId == requestId
          && getAfter(/databases/$(database)/documents/knowledge_answers/$(request.resource.data.acceptedAnswerId)).data.answerAuthor == request.resource.data.acceptedAnswerAuthor)
        || (changedOnly(['answerCount'])
          && request.resource.data.answerCount == resource.data.answerCount + 1)
      );
      allow delete: if isMyWallet(resource.data.author) && resource.data.status == 'open';
    }

    match /knowledge_answers/{answerId} {
      allow read: if signedIn();
      allow create: if isMyWallet(request.resource.data.answerAuthor)
        && request.resource.data.status == 'submitted'
        && get(/databases/$(database)/documents/knowledge_requests/$(request.resource.data.requestId)).data.author == request.resource.data.requestAuthor;
      allow update: if signedIn()
        && isMyWallet(get(/databases/$(database)/documents/knowledge_requests/$(resource.data.requestId)).data.author)
        && changedOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted';
      allow delete: if false;
    }

    match /emuer_bounty_claims/{claimId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isMyWallet(request.resource.data.requestAuthor)
        && request.resource.data.status == 'pending'
        && getAfter(/databases/$(database)/documents/knowledge_requests/$(request.resource.data.requestId)).data.status == 'awarded'
        && getAfter(/databases/$(database)/documents/knowledge_requests/$(request.resource.data.requestId)).data.settlementStatus == 'pending_distribution'
        && request.resource.data.requestAuthor == getAfter(/databases/$(database)/documents/knowledge_requests/$(request.resource.data.requestId)).data.author
        && request.resource.data.recipient == getAfter(/databases/$(database)/documents/knowledge_requests/$(request.resource.data.requestId)).data.acceptedAnswerAuthor
        && request.resource.data.amount == getAfter(/databases/$(database)/documents/knowledge_requests/$(request.resource.data.requestId)).data.bounty;
      allow update, delete: if false;
    }

    match /ichinichi_days/{document=**} {
      allow read, write: if false;
    }
    match /ichinichi_goods/{document=**} {
      allow read, write: if false;
    }
    match /ichinichi_reports/{document=**} {
      allow read, write: if false;
    }
    match /ichinichi_adopts/{document=**} {
      allow read, write: if false;
    }

    match /scheduled_posts/{document=**} {
      allow read, write: if false;
    }

    match /sp_notifications/{document=**} {
      allow read, write: if false;
    }

    match /room1_contents/{document=**} {
      allow read, write: if false;
    }
    match /room1_submissions/{document=**} {
      allow read, write: if false;
    }
    match /contact_submissions/{document=**} {
      allow read, write: if false;
    }
    match /user_profiles/{address} {
      allow read: if true;
      allow write: if false;
    }
    // EMUERの表示用キャッシュ（localStorageの写し）。ドキュメントIDは本人のウォレット。
    // 残高の正は emuer_offchain（サーバー専用）なので、ここは本人が自分の分だけ書ければよい。
    match /emuer_rate/{wallet} {
      allow read: if true;
      allow write: if isMyWallet(wallet);
    }
    // エアドロ登録。GENESISバッジの表示でクライアントが読むため、読み取りは開ける。
    // （登録はサーバーの /airdrop/register が行うので書き込みは閉じたまま）
    match /airdrop_registrations/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /secret_door_rewards/{document=**} {
      allow read, write: if false;
    }
    match /monthly_distributions/{document=**} {
      allow read, write: if false;
    }
    match /bonus_rewards/{document=**} {
      allow read, write: if false;
    }

    // 既存の施設・議論等は現状維持。上記の重要コレクションはここへ到達しない。
    match /{coll}/{document=**} {
      allow read, write: if coll != 'emuer_offchain'
        && coll != 'emuer_offchain_ledger'
        && coll != 'ches_accounts'
        && coll != 'ches_wallets'
        && coll != 'posts'
        && coll != 'knowledge_drafts'
        && coll != 'post_good_impacts'
        && coll != 'post_changes'
        && coll != 'knowledge_requests'
        && coll != 'knowledge_answers'
        && coll != 'emuer_bounty_claims'
        && coll != 'ichinichi_days'
        && coll != 'ichinichi_goods'
        && coll != 'ichinichi_reports'
        && coll != 'ichinichi_adopts'
        && coll != 'scheduled_posts'
        && coll != 'sp_notifications'
        && coll != 'room1_contents'
        && coll != 'room1_submissions'
        && coll != 'contact_submissions'
        && coll != 'user_profiles'
        && coll != 'emuer_rate'
        && coll != 'airdrop_registrations'
        && coll != 'secret_door_rewards'
        && coll != 'monthly_distributions'
        && coll != 'bonus_rewards'
        && coll != 'subscriptions'
        && coll != 'billing_events'
        && coll != 'refund_requests'
        && coll != 'kyc_submissions'
        && coll != 'dialogue_sessions'
        && coll != 'dialogue_slots'
        && coll != 'admin_audit_logs'
        && coll != 'emu_feedback'
        && coll != 'discussion_conclusions'
        && coll != 'discussion_rooms';
    }
  }
}
