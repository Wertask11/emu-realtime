rules_version = '2';

/* ══════════════════════════════════════════════════════════════
   Firebase Storage のセキュリティルール

   このプロジェクトでは、クライアントから Storage を直接読み書きしない。
   アップロードも削除も、すべてバックエンド（Admin SDK）を通す。
   Admin SDK はこのルールをバイパスするため、ここは
   「ブラウザから来る全てを止める」ためだけに存在する。

   ── /kyc/ について ──
   本人確認書類（運転免許証・パスポート等）の置き場所。
   漏れたときの被害が最も大きいので、ここは誰にも開けない。
   オーナー本人であってもブラウザからは読めない。
   閲覧はバックエンドが発行する3分間の署名付きURLだけで、
   その発行は requireOwner（オーナーのウォレットアドレス）で守られ、
   誰がいつ誰の書類を見たかは監査ログに残る。

   「オーナーだけが読める」をルールで表現しない理由:
   Storage のルールから Firestore の ches_accounts を参照できないため、
   ここで「オーナーかどうか」を正しく判定する手段がない。
   中途半端に request.auth != null で開けると、ログインさえすれば
   他人の書類を読めてしまう。だから全て閉じ、判定はサーバーに寄せる。
   ══════════════════════════════════════════════════════════════ */
service firebase.storage {
  match /b/{bucket}/o {

    /* 本人確認書類 ── 完全遮断
       パスは kyc/{uid}/{ランダム}_{時刻}_{面} 。
       ルールで塞いだうえで、パスも推測できないようにしてある。 */
    match /kyc/{allPaths=**} {
      allow read, write: if false;
    }

    /* 投稿画像 ── 表示のため読み取りだけ公開
       アップロードは /upload/image（Admin SDK）が行うので書き込みは閉じる。 */
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    /* 上記以外は既定で拒否。
       新しい用途を足すときは、ここに明示的に追加する。
       「とりあえず開ける」を作らないこと。 */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
