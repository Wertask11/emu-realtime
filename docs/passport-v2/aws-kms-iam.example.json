{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribePinnedIssuerKey",
      "Effect": "Allow",
      "Action": ["kms:GetPublicKey", "kms:DescribeKey"],
      "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/KEY_ID"
    },
    {
      "Sid": "SignOnlyWithPinnedIssuerKey",
      "Effect": "Allow",
      "Action": "kms:Sign",
      "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/KEY_ID",
      "Condition": {"StringEquals": {"kms:SigningAlgorithm": "ECDSA_SHA_256"}}
    }
  ]
}
