{
  "name": "emu-walletconnect-bundle",
  "private": true,
  "description": "WalletConnect（@walletconnect/ethereum-provider）を1つのファイルにまとめて frontend/public/vendor/walletconnect/ に置く。",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --platform=browser --target=es2020 --define:process.env.NODE_ENV='\"production\"' --define:global=globalThis --outfile=../../frontend/public/vendor/walletconnect/ethereum-provider-2.26.0.js"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "2.26.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
